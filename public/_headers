# Response headers for the Cloudflare Workers static-assets deploy (wrangler.jsonc).
# Next copies public/ into out/, and Cloudflare applies this file to every matching response.
# Without it every file is served with "max-age=0, must-revalidate".

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# JS, CSS and fonts: the file name changes whenever the content does, so cache for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Responsive image variants (scripts/image-variants.mjs) keep their name when a source image is
# replaced, so cache for a day only.
/_img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
